# Copy to .env for local-only settings. Do not commit credentials or provider data.
SPECPILOT_ENV=development

# A throwaway PostgreSQL for the ledger integration tests. Nothing in it is
# real corpus data, but it is still local-only. `make integration-db` refuses
# to run without this, because a skipped run produces no concurrency or
# recovery evidence and must not look like a pass.
SPECPILOT_TEST_DSN=postgresql://localhost:5432/specpilot_test

# Provider credentials for `provider route-smoke --live`. Read from the
# environment only: never written to a config file, a trace, an error, or a
# report, and never committed. Each route has its own variable because the two
# routes are different accounts at different companies -- sharing one would
# make a judge call spend the main chain's credentials.
#
# Leave both unset for every other command. Nothing else in the repository
# reads them, and `--fixture-only` never needs one.
SPECPILOT_MAIN_API_KEY=
SPECPILOT_JUDGE_API_KEY=
